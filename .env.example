# ---------------------------------------------------------------
# 이 파일을 .env 로 복사해서 값을 채우세요.  .env 는 git 에 올라가지 않습니다.
# ---------------------------------------------------------------

# Claude API 키  (https://platform.claude.com/ 에서 발급)
ANTHROPIC_API_KEY=sk-ant-...

# 네이버 로그인 쿠키 2개.  채팅을 "보내려면" 반드시 필요합니다.
# 읽기만 할 거면 비워둬도 됩니다.
#
# 얻는 방법 (PC 크롬 기준):
#   1. chzzk.naver.com 에 로그인
#   2. F12 → Application 탭 → 왼쪽 Storage → Cookies → https://chzzk.naver.com
#   3. NID_AUT, NID_SES 두 개의 Value 를 그대로 복사
#
# ⚠️ 이 두 값은 네이버 계정 비밀번호와 거의 같은 수준의 비밀입니다.
#    절대 남에게 보여주거나 git 에 올리지 마세요.
NID_AUT=
NID_SES=
